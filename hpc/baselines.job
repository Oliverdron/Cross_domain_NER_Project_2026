#!/bin/bash
# ──────────────────────────────────────────────────────────────────────────────
# baselines.job
#
# Runs scripts/run_baselines.py — three single-domain baselines (ewt_only,
# conll_only, astro_only) × 3 seeds = 9 fine-tunes total. Hyperparameters
# match experiments/config_conll.yaml + config_astro.yaml so the baselines
# can be fairly compared against the iterative runs.
#
# Submit:
#   sbatch hpc/baselines.job
#
# Outputs land in:
#   /home/olgy/Cross_domain_NER_Project_2026/runs/baselines/{ewt,conll,astro}_only/
# ──────────────────────────────────────────────────────────────────────────────
#SBATCH --job-name=baselines
#SBATCH --output=hpc/logs/%x_%j.out
#SBATCH --error=hpc/logs/%x_%j.err
#SBATCH --partition=acltr
#SBATCH --gres=gpu:1
# Any modern GPU (V100, A100, H100, L40s, RTX6000, A30) is fine —
# bert-base peaks at ~2 GB GPU memory.
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=12:00:00                       # 9 fine-tunes × ~30 min ≈ 4–5h; 12h gives generous margin
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --mail-type=BEGIN,END,FAIL,TIME_LIMIT_80
#SBATCH --mail-user=olgy@itu.dk

set -euo pipefail

# ── Paths ────────────────────────────────────────────────────────────────────
PROJECT_DIR="/home/olgy/Cross_domain_NER_Project_2026"
ENV_NAME="ner"
export TMPDIR="/home/olgy/tmp"
mkdir -p "${TMPDIR}" "${PROJECT_DIR}/hpc/logs"

cd "${PROJECT_DIR}"

# ── Modules + conda env ──────────────────────────────────────────────────────
module purge
module load Anaconda3
module load CUDA/12.1.1

source activate "${ENV_NAME}"

export HF_HOME="/home/olgy/.cache/huggingface"
mkdir -p "${HF_HOME}"

export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false

# ── Diagnostics ──────────────────────────────────────────────────────────────
echo "── env ──"
hostname
date
nvidia-smi
python -c "import torch; print('cuda available:', torch.cuda.is_available(), '| device:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else None)"

# ── Train ────────────────────────────────────────────────────────────────────
echo "── starting run_baselines.py ──"
srun python -u scripts/run_baselines.py --device cuda

echo "── done ──"
date
