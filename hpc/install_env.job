#!/bin/bash
# ──────────────────────────────────────────────────────────────────────────────
# install_env.job
#
# One-time job: creates the `ner` conda env from the system Anaconda3 module
# and installs torch (CUDA 12.1) + project requirements into it.
#
# Run from: /home/olgy/Cross_domain_NER_Project_2026
#   sbatch hpc/install_env.job
#
# Why a job and not the login node:
#   ITU HPC docs require env creation to happen in a SLURM job, not on the
#   login node (https://hpc.itu.dk/software/anaconda/conda_install_slurm/).
# ──────────────────────────────────────────────────────────────────────────────
#SBATCH --job-name=ner_install
#SBATCH --output=hpc/logs/install_%j.out
#SBATCH --error=hpc/logs/install_%j.err
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=01:00:00
#SBATCH --partition=scavenge

set -euo pipefail

# ── Paths ────────────────────────────────────────────────────────────────────
PROJECT_DIR="/home/olgy/Cross_domain_NER_Project_2026"
ENV_NAME="ner"
export TMPDIR="/home/olgy/tmp"
mkdir -p "${TMPDIR}" "${PROJECT_DIR}/hpc/logs"

cd "${PROJECT_DIR}"

# ── 1. Load the system Anaconda3 module ──────────────────────────────────────
module purge
module load Anaconda3

# ── 2. Create the env if it doesn't already exist ────────────────────────────
# Conda envs default to ~/.conda/envs/<name>, which persists across logins.
if ! conda env list | awk '{print $1}' | grep -qx "${ENV_NAME}"; then
    echo "[install_env] Creating conda env '${ENV_NAME}' (python 3.11)…"
    conda create -y -n "${ENV_NAME}" python=3.11
else
    echo "[install_env] Env '${ENV_NAME}' already exists, will install into it."
fi

# ── 3. Activate it (legacy `source activate` works without conda init) ──────
source activate "${ENV_NAME}"

# ── 4. Install pytorch with CUDA 12.1 wheels, then the rest ─────────────────
# The cu121 wheels bundle their own CUDA runtime, so this works whether or not
# `module load CUDA/12.1.1` is loaded at runtime — but we still load it in
# train jobs to match ITU's conventions and to expose nvcc if anything needs it.
echo "[install_env] Installing pytorch (cu121)…"
pip install --no-cache-dir \
    torch --index-url https://download.pytorch.org/whl/cu121

echo "[install_env] Installing project requirements…"
pip install --no-cache-dir \
    transformers seqeval "numpy<2" tqdm datasets scikit-learn pyyaml pandas matplotlib evaluate

# ── 5. Quick sanity check ────────────────────────────────────────────────────
python - <<'PY'
import torch, transformers
print("torch          :", torch.__version__)
print("transformers   :", transformers.__version__)
print("cuda available :", torch.cuda.is_available())
print("cuda runtime   :", torch.version.cuda)
PY

echo "[install_env] Done. Env '${ENV_NAME}' is at ~/.conda/envs/${ENV_NAME}"
