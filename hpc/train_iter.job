#!/bin/bash
# ──────────────────────────────────────────────────────────────────────────────
# train_iter.job
#
# Runs scripts/run_experiment.py for one config (CoNLL or Astro) on a V100.
#
# Submit with the config picked at submit time:
#   sbatch --job-name=iter_conll --export=ALL,CFG=experiments/config_conll.yaml hpc/train_iter.job
#   sbatch --job-name=iter_astro --export=ALL,CFG=experiments/config_astro.yaml hpc/train_iter.job
#
# Outputs land in:
#   /home/olgy/Cross_domain_NER_Project_2026/runs/<experiment_name>/...
# (controlled by the YAML's `output_dir` + `experiment_name`)
# ──────────────────────────────────────────────────────────────────────────────
#SBATCH --output=hpc/logs/%x_%j.out          # %x = job-name, %j = job id
#SBATCH --error=hpc/logs/%x_%j.err
#SBATCH --partition=acltr
#SBATCH --gres=gpu:v100:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=2-00:00:00                    # 2 days; acltr allows up to 3 for students
#SBATCH --nodes=1
#SBATCH --ntasks=1

set -euo pipefail

# ── Inputs ───────────────────────────────────────────────────────────────────
CFG="${CFG:-experiments/config_conll.yaml}"   # default if not exported

# ── Paths ────────────────────────────────────────────────────────────────────
PROJECT_DIR="/home/olgy/Cross_domain_NER_Project_2026"
ENV_NAME="ner"
export TMPDIR="/home/olgy/tmp"
mkdir -p "${TMPDIR}" "${PROJECT_DIR}/hpc/logs"

cd "${PROJECT_DIR}"

# ── Modules + conda env ──────────────────────────────────────────────────────
module purge
module load Anaconda3
module load CUDA/12.1.1

source activate "${ENV_NAME}"

# Cache HF downloads in /home/olgy/.cache so the model is fetched once and
# re-used across iterations / re-submissions.
export HF_HOME="/home/olgy/.cache/huggingface"
mkdir -p "${HF_HOME}"

# Determinism-friendly knobs (does not slow us down meaningfully here).
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false

# ── Diagnostics — show up in the .out so you can debug if it breaks ─────────
echo "── env ──"
hostname
date
echo "CFG = ${CFG}"
nvidia-smi
python -c "import torch; print('cuda available:', torch.cuda.is_available(), '| device:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else None)"

# ── Train ────────────────────────────────────────────────────────────────────
echo "── starting run_experiment.py ──"
srun python -u scripts/run_experiment.py --config "${CFG}" --device cuda

echo "── done ──"
date
